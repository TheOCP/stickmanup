<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.stickmanup"
    android:versionCode="68"
    android:versionName="4.10.27">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- The cheat tools the anticheat looks for, and root apps it notes. Android hides other apps otherwise. -->
    <queries>
        <package android:name="catch_.me_.if_.you_.can_" />
        <package android:name="com.cih.game_cih" />
        <package android:name="cn.mc.sq" />
        <package android:name="org.sbtools.gamehack" />
        <package android:name="com.luckypatchers.luckypatcherinstaller" />
        <package android:name="com.android.vending.billing.InAppBillingService.LUCK" />
        <package android:name="com.android.vending.billing.InAppBillingService.CLON" />
        <package android:name="com.chelpus.lackypatch" />
        <package android:name="com.dimonvideo.luckypatcher" />
        <package android:name="com.forpda.lp" />
        <package android:name="ru.aaaaaaac.installer" />
        <package android:name="ru.gameguardian" />
        <package android:name="com.xmodgame" />
        <package android:name="com.gamecih.cheat" />
        <package android:name="com.sbgamehacker.pro" />
        <package android:name="com.saitesoft.gamecheater" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="de.robv.android.xposed.installer" />
        <package android:name="org.lsposed.manager" />
        <package android:name="org.meowcat.edxposed.manager" />
        <package android:name="com.solohsu.android.edxp.manager" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Updates: the game downloads its own next release and hands it to Android (Updater.java). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:label="StickManUp"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.StickManUp"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:isGame="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The browser hands the one time sign in code back to the game. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stickmanup" android:host="auth" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Restart"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
